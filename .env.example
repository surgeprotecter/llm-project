# Required for real model/tool runs. Offline mock mode must be selected explicitly.
DEEPSEEK_API_KEY=
TRAVEL_AGENT_MODEL=deepseek-flash
TRAVEL_AGENT_API_BASE=https://api.deepseek.com
TRAVEL_AGENT_DATABASE_PATH=travel_agent.sqlite3
TRAVEL_AGENT_OUTPUT_DIR=artifacts
TRAVEL_AGENT_MCP_CONFIG=
TRAVEL_AGENT_TOOL_MODE=real
TRAVEL_AGENT_CONTEXT_TOKEN_BUDGET=36000
TRAVEL_AGENT_SUMMARY_MODEL=deepseek-flash
# MAX_PLANNER_STEPS applies only to the legacy offline workflow, not the real Agent loop.
TRAVEL_AGENT_MAX_PLANNER_STEPS=8
TRAVEL_AGENT_MAX_TOOL_RETRIES=2
