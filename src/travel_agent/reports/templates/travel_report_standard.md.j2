{# Shared data-only macros keep HTML and Markdown compatibility rules aligned. #}
{%- macro timeline_for(day, result) -%}
  {%- set result.entries = [] -%}
  {%- set result.legacy = not day.get('timeline') -%}
  {%- set result.labels = {'sightseeing':'游览', 'meal':'用餐', 'cafe':'咖啡', 'shop':'购物', 'activity':'体验', 'transfer':'交通', 'free_time':'自由时间', 'friend_time':'会友'} -%}
  {%- set primary = day.get('timeline') or day.get('stops') or [] -%}
  {%- for item in primary if item is mapping -%}
    {%- set kind = item.get('type') or ('sightseeing' if result.legacy else 'activity') -%}
    {%- set kind = kind if kind in result.labels else 'activity' -%}
    {%- set legs = day.get('legs') or [] -%}
    {%- set route = namespace(leg=legs[loop.index0] if result.legacy and loop.index0 < legs|length else {}) -%}
    {# Route legs still refer to primary stops, not meals or their alternatives. #}
    {%- if not result.legacy and legs -%}
      {%- for stop in day.get('stops') or [] if stop is mapping -%}
        {%- if loop.index0 < legs|length and ((item.get('id') and item.get('id') == stop.get('id')) or (item.get('name') and item.get('name') == stop.get('name'))) -%}
          {%- set route.leg = legs[loop.index0] -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- set result.entries = result.entries + [dict(item, type=kind, route_leg=route.leg, sort_time=item.get('start_time') or '99:99')] -%}
  {%- endfor -%}
  {%- if result.legacy -%}
    {%- for food in day.get('food') or [] -%}
      {%- set match = namespace(item=food if food is mapping else {'name':food}) -%}
      {%- for candidate in report.get('food') or [] if candidate is mapping and candidate.get('name') == match.item.get('name') -%}
        {%- set match.item = dict(candidate, **match.item) -%}
      {%- endfor -%}
      {%- set kind = match.item.get('type') or ('cafe' if match.item.get('kind') in ['咖啡','咖啡馆','cafe','coffee'] else 'meal') -%}
      {%- set kind = kind if kind in result.labels else 'meal' -%}
      {%- if match.item.get('name') and match.item.get('name') not in result.entries|map(attribute='name')|list -%}
        {%- set result.entries = result.entries + [dict(match.item, type=kind, sort_time=match.item.get('start_time') or '99:99')] -%}
      {%- endif -%}
    {%- endfor -%}
    {%- set result.entries = result.entries|sort(attribute='sort_time') -%}
  {%- endif -%}
{%- endmacro -%}

{%- macro hotel_photos(hotel, result) -%}
  {%- set result.photos = [] -%}
  {%- set result.keys = [] -%}
  {# Use the legacy image only if the array contains no usable photo. #}
  {%- for batch in [hotel.get('images') or [], [hotel.get('image_url')]] if not result.photos -%}
    {%- set batch = [batch] if batch is string else batch -%}
    {%- for photo in batch -%}
      {%- set url = (photo.get('url') or photo.get('src') or photo.get('image_url') or '') if photo is mapping else photo -%}
      {%- if url is string -%}
        {%- set url = url|trim -%}
        {%- set key = url.split('#')[0] -%}
        {%- if '/xdata/images/hotel/' in key -%}
          {%- set key = key.split('?')[0].split('/')[-1].split('.')[0] -%}
        {%- endif -%}
        {%- if (url.startswith('https://') or url.startswith('http://')) and key not in result.keys -%}
          {%- set result.photos = result.photos + [{'url':url, 'alt':photo.get('alt') if photo is mapping else ''}] -%}
          {%- set result.keys = result.keys + [key] -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endmacro -%}

{%- macro transport_scope(transport, result) -%}
  {%- set result.date = transport.get('date') -%}
  {%- for option in transport.get('options') or [] if option is mapping and option.get('baseline') and option.get('planning_departure_date') -%}
    {%- set result.date = option.planning_departure_date -%}
  {%- endfor -%}
  {%- set result.round_trip = transport.get('round_trip') == true or transport.get('trip_type') == 'round_trip' -%}
  {%- if transport.get('round_trip') is none and transport.get('trip_type') != 'one_way' -%}
    {%- for option in transport.get('options') or [] if option is mapping -%}
      {%- set directions = option.get('directions') or [] -%}
      {%- if directions|selectattr('direction', 'equalto', 'outbound')|list and directions|selectattr('direction', 'equalto', 'return')|list -%}
        {%- set result.round_trip = true -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endmacro -%}

{%- macro budget_preference(value, result) -%}
  {%- set value = value or {} -%}
  {%- set currency = value.get('currency') or '' -%}
  {%- set result.cap = value.get('max_amount') if value.get('max_amount') is not none else value.get('amount') -%}
  {%- set result.specified = true -%}
  {%- if value.get('amount') is not none -%}
    {%- set result.text = '全体目标预算 ' ~ value.amount ~ ' ' ~ currency -%}
  {%- elif value.get('min_amount') is not none and value.get('max_amount') is not none -%}
    {%- set result.text = '全体预算范围 ' ~ value.min_amount ~ '–' ~ value.max_amount ~ ' ' ~ currency -%}
  {%- elif value.get('min_amount') is not none -%}
    {%- set result.text = '全体预算下限 ≥ ' ~ value.min_amount ~ ' ' ~ currency ~ ' · 未设上限' -%}
  {%- elif value.get('max_amount') is not none -%}
    {%- set result.text = '全体预算上限 ≤ ' ~ value.max_amount ~ ' ' ~ currency -%}
  {%- else -%}
    {%- set result.text = '全体目标预算待补充' -%}
    {%- set result.specified = false -%}
  {%- endif -%}
{%- endmacro -%}

{%- macro budget_warning(budget, preference) -%}
  {%- if preference.cap is not none and budget.get('high') is not none and budget.high > preference.cap -%}
    {{ '预计超出' if budget.low > preference.cap else '估算上限可能超出' }}预算 {{ preference.cap|round|int }} {{ budget.currency }}。
  {%- endif -%}
{%- endmacro -%}

{%- macro quality_state(result) -%}
  {%- set quality = report.get('quality') or {} -%}
  {%- set result.failed = quality.get('failed') or quality.get('passed') == false or report.get('status') in ['draft','草稿'] -%}
  {%- set result.gaps = quality.get('gaps') or quality.get('issues') or [] -%}
  {%- if not result.gaps and quality.get('failed') is sequence and quality.get('failed') is not string -%}
    {%- set result.gaps = quality.get('failed') -%}
  {%- endif -%}
  {%- if result.gaps is string -%}{%- set result.gaps = [result.gaps] -%}{%- endif -%}
{%- endmacro -%}
